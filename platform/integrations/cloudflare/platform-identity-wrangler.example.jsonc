{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thinkamigbob-platform-identity",
  "main": "./platform-identity-worker.mjs",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "services": [
    {
      "binding": "PLATFORM_AUTH",
      "service": "thinkamigbob-platform-auth"
    }
  ],
  "ratelimits": [
    {
      "name": "STUDENT_ENTRY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRODUCTION_ENABLED": "false",
    "STUDENT_ACCESS_ENABLED": "false",
    "PLATFORM_ORIGIN": "https://REPLACE-WITH-PUBLISHED-PLATFORM.example",
    "GOOGLE_SIGNIN_CLIENT_ID": "REPLACE-WITH-PUBLIC-GOOGLE-SIGNIN-CLIENT-ID",
    "ALLOWED_TEACHER_EMAILS": "REPLACE-WITH-APPROVED-PILOT-TEACHER"
  }
}
